# NanoGPT
NANOGPT_API_KEY=your_nanogpt_key_here
NANOGPT_MODEL=zai-org/glm-4.7:thinking

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local / OpenAI-compatible server (LM Studio, Ollama, etc.)
# Set LOCAL_OPENAI_BASE_URL to your server's base URL
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=local-model
LOCAL_API_KEY=local
