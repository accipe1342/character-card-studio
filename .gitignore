# ─────────────────────────────────────────────────────────────
# Character Card Studio — files that must never be committed
# ─────────────────────────────────────────────────────────────

# Secrets: API keys live in .env (copy _env.example to start)
.env
.env.*
!.env.example
*.pem
*.key

# Your data: cards, lore, texts and their backups
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output (browser test screenshots)
tests/e2e/out/

# Logs
*.log
logs/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local exports and bundles you download from the app
*-deeplore.zip
card-studio-bundle-*.zip
