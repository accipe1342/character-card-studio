{% extends "base.html" %}
{% block title %}Config - Character Card Studio{% endblock %}
{% block nav_config %}active{% endblock %}

{% block content %}

<div class="page-header">
  <h1>Config</h1>
  <p class="muted">Edit the prompt templates used for character generation and field regeneration.</p>
</div>

<div class="card">
  <h2>Template Variables</h2>
  <div class="muted">
    <p><strong>Character Generation Template</strong> must support:</p>
    <ul>
      <li><code>{source_json}</code></li>
    </ul>

    <p><strong>Field Regeneration Template</strong> must support:</p>
    <ul>
      <li><code>{field_name_instruction}</code></li>
      <li><code>{custom_prompt_block}</code></li>
      <li><code>{shape_json}</code></li>
      <li><code>{source_json}</code></li>
      <li><code>{current_card_json}</code></li>
    </ul>
  </div>
</div>

<div class="card">
  <form method="POST" action="/config">
    <div class="field">
      <label for="character_generation_template">Character Generation Template</label>
      <textarea
        id="character_generation_template"
        name="character_generation_template"
        style="min-height:320px;"
      >{{ prompts.character_generation_template }}</textarea>
    </div>

    <div class="field" style="margin-top:18px;">
      <label for="field_regeneration_template">Field Regeneration Template</label>
      <textarea
        id="field_regeneration_template"
        name="field_regeneration_template"
        style="min-height:320px;"
      >{{ prompts.field_regeneration_template }}</textarea>
    </div>

    <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap;">
      <button type="submit" name="action" value="save">Save Config</button>
      <button type="submit" name="action" value="reset">Reset to Default</button>
    </div>
  </form>
</div>

{% endblock %}